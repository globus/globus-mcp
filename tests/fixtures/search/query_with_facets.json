            "titles": [
              {
                "title": "Inhibitory effect of whey protein concentrate on SARS-CoV-2-targeted furin activity and spike protein-ACE2 binding in methotrexate-induced lung damage."
              }
            ],
            "publisher": {
              "name": "Journal of food biochemistry"
